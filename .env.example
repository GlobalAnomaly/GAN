# Copy to .env.local and fill in. .env.local is gitignored and is never
# deployed: a hosted build reads its own environment variables, set in the
# host's dashboard. Editing this file has no effect on the live site.
#
# Next reads .env.local at server start. After changing anything here, stop
# `npm run dev` and start it again. A Fast Refresh will not pick it up, and the
# result looks identical to the value not being set at all.

# ---------------------------------------------------------------------------
# The public site
# ---------------------------------------------------------------------------
# Leave as localhost for development. In production the host sets the real
# domain, and Vercel injects its own production URL even when this is unset, so
# a first deploy is correct without anyone knowing the URL in advance. A bare
# domain with no protocol is accepted and normalised rather than failing the
# build, because that is the natural thing to paste into a dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# The anon key is safe in the browser: row-level security only exposes cases
# where published is true, and reports only where their source permits it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The bot and the loaders only. Bypasses row-level security entirely, so it must
# never be referenced from anything under src/ that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin panel: LOCAL ONLY
# ---------------------------------------------------------------------------
# The gate on everything under /admin. Without it the panel is unreachable
# rather than open, which is the right way round for something that can write to
# the database and start the bot.
#
# Do NOT set this on the host. The panel cannot work on a deployed site: the
# review inbox is a JSON file at .data/inbox.json, and a serverless filesystem
# is ephemeral and read-only, so the inbox would read empty and refuse writes.
# The bot also needs Ollama, which runs on this machine. Setting it in a
# dashboard would produce a panel that looks functional and silently does
# nothing, which is worse than one that is plainly closed.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Ollama, for drafting
# ---------------------------------------------------------------------------
# The default model for writing accounts. llama3.1:8b is the blueprint's main
# drafting engine: it fits comfortably in 16GB and is most reliable when told to
# use only the text it was given, which is exactly how the prompts work.
#
# gemma4:12b is also installed and is the stronger, more multilingual option.
# The blueprint flags translation as where an 8B model is weakest, so the two are
# worth splitting by task rather than choosing between them: draft with 8b for
# speed, translate with 12b for quality. That split is not wired up yet. Both are
# named here so the choice is visible rather than buried in a shell history.
OLLAMA_MODEL=llama3.1:8b

# Where Ollama listens. Only needed if it is not the default.
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# YouTube Data API v3
# ---------------------------------------------------------------------------
# A free key gets 10,000 units a day. Walking a channel costs 1 unit per 50
# videos; a search costs 100 per 50. See bot/README.md for the quota maths.
YOUTUBE_API_KEY=
