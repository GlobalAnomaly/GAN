# Copy to .env.local and fill in. .env.local is gitignored.

# The public site. Vercel/Netlify set this once a domain exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. The anon key is safe in the browser: row-level security only
# exposes rows where published is true.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The bot only. Bypasses row-level security, so it must never be referenced
# from anything under src/ that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3. See bot/README.md for how to get one.
YOUTUBE_API_KEY=
