{
  "name": "global-anomaly-network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bot:youtube": "tsx --env-file-if-exists=.env.local bot/fetch-youtube.ts",
    "bot:import-seed": "tsx --env-file-if-exists=.env.local bot/import-seed.ts",
    "bot:write": "tsx --env-file-if-exists=.env.local bot/write-account.ts",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/check-db.ts",
    "typecheck:bot": "tsc --noEmit -p tsconfig.bot.json",
    "bot:overnight": "tsx --env-file-if-exists=.env.local bot/run-overnight.ts",
    "bot:test": "node --import tsx --test src/lib/**/*.test.ts src/lib/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
